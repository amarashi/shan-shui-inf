{
  "name": "coast-inf",
  "version": "0.0.0",
  "private": true,
  "description": "Seeded, infinitely scrolling Australian coastal landscape, drawn in SVG. A fork of {Shan, Shui}* by Lingdong Huang.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "golden:record": "node tools/golden.js record",
    "golden:check": "node tools/golden.js check",
    "sheet": "node tools/sheet.js",
    "specimen": "node tools/specimen.js",
    "perf": "node tools/perf.js",
    "build": "vite build -c vite.lib.config.js",
    "perf:embed": "node tools/perf-embed.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pure-rand": "^8.4.2",
    "simplex-noise": "^4.0.3"
  },
  "sideEffects": [
    "./src/embed/element.js",
    "./dist/element.js",
    "./src/embed/worker.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./element": "./src/embed/element.js"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
